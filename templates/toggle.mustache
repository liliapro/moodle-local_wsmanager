{{!
    @template local_wsmanager/toggle

    Template for toggle element compatible with core/toggle

    Example context (json):
    {
        "id": "webservice-toggle-1",
        "checked": true,
        "disabled": false,
        "dataattributes": [{
            "name": "action",
            "value": "toggle-webservice"
        }],
        "title": "Enable/disable webservice",
        "label": "Enable webservice",
        "labelclasses": "visually-hidden",
        "name": "webservice_enabled",
        "value": "1"
    }
}}
<div class="form-check form-switch">
    <input class="form-check-input"
           type="checkbox"
           role="switch"
           id="{{id}}"
           {{#name}}name="{{name}}"{{/name}}
        {{#value}}value="{{value}}"{{/value}}
        {{#checked}}checked{{/checked}}
        {{#disabled}}disabled{{/disabled}}
        {{#title}}title="{{title}}"{{/title}}
        {{#dataattributes}}
           data-{{name}}="{{value}}"
        {{/dataattributes}}
        {{#checked}}aria-checked="true"{{/checked}}
        {{^checked}}aria-checked="false"{{/checked}}>
    <label class="form-check-label {{labelclasses}}" for="{{id}}">
        {{$labelmarkup}}
            {{$label}}{{label}}{{/label}}
        {{/labelmarkup}}
    </label>
</div>
